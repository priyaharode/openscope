# GEMINI_API_KEY: Optional AI acceleration key for enhanced entity and summary generation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPENALEX_EMAIL: Contact email provided to OpenAlex polite pool for 10 req/s unthrottled access
OPENALEX_EMAIL="researcher@openscope.org"

# PORT: Server port (defaults to 3000)
PORT=3000

# DATABASE_URL: PostgreSQL connection string for production persistence
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openscope"

# FIREBASE AUTHENTICATION CONFIGURATION (Client-Side Vite prefix)
# Obtain these from your Firebase Project Console -> Project Settings -> General -> Your apps
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

